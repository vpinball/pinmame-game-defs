{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vpinball/pinmame-game-defs/schemas/vpx-candidate-register.schema.json",
  "title": "VPX source candidate register",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "machine_id", "search_order", "vpxtool", "candidates"],
  "properties": {
    "format": { "const": "pinmame-vpx-candidate-register" },
    "version": { "const": 1 },
    "machine_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "search_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["Visual Pinball/Tables", "Visual Pinball/Tables Archive", "vpuniverse.com", "vpforums.org"] }
    },
    "vpxtool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "operation"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]).+$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["search_rank", "root", "relative_path", "original_filename", "bytes", "sha256", "vpxtool_romname", "vpxtool_table_name", "decision", "reason", "extracted_script"],
      "properties": {
        "search_rank": { "type": "integer", "minimum": 1 },
        "root": { "enum": ["Visual Pinball/Tables", "Visual Pinball/Tables Archive", "vpuniverse.com", "vpforums.org"] },
        "source_uri": { "type": "string", "format": "uri" },
        "relative_path": { "$ref": "#/$defs/portablePath" },
        "original_filename": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "vpxtool_romname": { "type": "string", "minLength": 1 },
        "vpxtool_table_name": { "type": "string" },
        "decision": { "enum": ["rejected", "accepted", "candidate"] },
        "reason": { "type": "string", "minLength": 1 },
        "same_source_as": {
          "$ref": "#/$defs/portablePath",
          "description": "Root-relative path of the byte-identical candidate under the same root."
        },
        "extracted_script": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "bytes", "sha256"],
          "properties": {
            "path": { "$ref": "#/$defs/portablePath" },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    }
  }
}
