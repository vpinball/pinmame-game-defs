{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vpinball/pinmame-game-defs/schemas/manual-extraction.schema.json",
  "title": "Deterministic cached-manual extraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "document_id", "document_sha256", "extractor", "status", "page_count", "text_page_count", "character_count", "table_pages", "pages"],
  "properties": {
    "format": { "const": "pinmame-manual-extraction" },
    "version": { "const": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "document_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "library_version"],
      "properties": {
        "id": { "const": "pdfplumber" },
        "version": { "const": 1 },
        "library_version": { "type": "string", "minLength": 1 }
      }
    },
    "status": { "enum": ["text_native", "ocr_required"] },
    "page_count": { "type": "integer", "minimum": 1 },
    "text_page_count": { "type": "integer", "minimum": 0 },
    "character_count": { "type": "integer", "minimum": 0 },
    "table_pages": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "text", "text_sha256"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" },
          "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "tables": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
