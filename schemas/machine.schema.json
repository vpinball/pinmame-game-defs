{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vpinball/pinmame-game-defs/schemas/machine.schema.json",
  "title": "PinMAME physical-machine definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "machine",
    "coverage",
    "drivers",
    "inputs",
    "outputs",
    "displays",
    "mechanisms",
    "relationships",
    "sources",
    "knowledge"
  ],
  "properties": {
    "format": { "const": "pinmame-machine-definition" },
    "schema_version": {
      "description": "Version 2 adds optional spatial evidence. Version 1 definitions remain valid, but author-ready definitions must use version 2.",
      "enum": [1, 2]
    },
    "machine": { "$ref": "#/$defs/machineIdentity" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "controller": { "$ref": "#/$defs/controller" },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/driver" }
    },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/output" }
    },
    "displays": {
      "type": "array",
      "items": { "$ref": "#/$defs/display" }
    },
    "mechanisms": {
      "type": "array",
      "items": { "$ref": "#/$defs/mechanism" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "knowledge": { "$ref": "#/$defs/knowledge" },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": 2 } }, "required": ["schema_version"] },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "dimensions": { "required": ["spatial_placement"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage": {
            "properties": { "status": { "const": "author_ready" } },
            "required": ["status"]
          }
        },
        "required": ["coverage"]
      },
      "then": {
        "properties": { "schema_version": { "const": 2 } }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "machineIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "manufacturer", "year"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "manufacturer": { "type": "string", "minLength": 1 },
        "year": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
        "kind": { "enum": ["physical_pinball", "physical_conversion", "redemption_game", "diagnostic_software", "system_software", "unknown"] },
        "model_number": { "type": "string", "minLength": 1 },
        "ipdb_id": { "type": "integer", "minimum": 1 },
        "playfield": {
          "description": "Optional extent that normalized playfield coordinates map onto, so a consumer can render placements at the correct aspect ratio. Purely presentational: the normalized positions stay authoritative and nothing is required to read this.",
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "units"],
          "properties": {
            "width": { "description": "Extent along x, the left-to-right axis that normalized x = 0..1 spans.", "type": "number", "exclusiveMinimum": 0 },
            "height": { "description": "Extent along y, the rear-to-front axis that normalized y = 0..1 spans.", "type": "number", "exclusiveMinimum": 0 },
            "units": { "description": "vpx records the retained table's own bounds, which are the basis the normalized coordinates were computed from. mm and inch record measured physical dimensions.", "enum": ["vpx", "mm", "inch"] },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "missing", "dimensions"],
      "properties": {
        "status": { "enum": ["stub", "partial", "author_ready"] },
        "missing": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "identity",
              "driver_mapping",
              "controller_platform",
              "input_enumeration",
              "input_semantics",
              "output_enumeration",
              "output_semantics",
              "display_inventory",
              "mechanism_inventory",
              "mechanism_behavior",
              "polarity",
              "variant_differences",
              "recreation_notes",
              "provenance",
              "spatial_placement",
              "unresolved_conflicts"
            ]
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/assertionState" },
          "required": [
            "catalog_identity",
            "address_enumeration",
            "semantic_naming",
            "physical_wiring",
            "mechanisms",
            "variant_coverage",
            "recreation_knowledge"
          ]
        }
      }
    },
    "assertionState": {
      "enum": ["unknown", "candidate", "observed", "validated", "conflicted", "not_applicable"]
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform"],
      "properties": {
        "platform": { "$ref": "#/$defs/identifier" },
        "hardware_generation": { "type": "string", "pattern": "^0x[0-9a-f]+$" },
        "inversion_applied_by_emulator": { "type": "boolean" }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "year", "manufacturer", "flags"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "clone_of": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1 },
        "year": { "type": "string", "minLength": 1 },
        "manufacturer": { "type": "string", "minLength": 1 },
        "flags": { "type": "integer", "minimum": 0 },
        "physical_compatibility": { "description": "Compatibility of this ROM driver with the physical machine described by the containing definition.", "enum": ["identical", "compatible", "different", "unknown"] },
        "variant_notes": { "type": "string", "minLength": 1 },
        "display_overrides": {
          "description": "Driver-specific display-layout differences from the canonical physical-machine display inventory.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/displayOverride" }
        },
        "overrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/deviceOverride" }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "device"],
      "properties": {
        "group": { "$ref": "#/$defs/identifier" },
        "device": { "type": "integer" },
        "channel": { "type": "integer", "minimum": 0 }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "value"],
      "properties": {
        "namespace": { "$ref": "#/$defs/identifier" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_refs"],
      "properties": {
        "status": { "$ref": "#/$defs/assertionState" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "binding", "aliases", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["switch", "dip_switch", "constant", "virtual"] },
        "binding": { "$ref": "#/$defs/binding" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/alias" }
        },
        "normally_closed": { "type": "boolean" },
        "pulse": { "type": "boolean" },
        "initial_active": {
          "description": "Controller-facing active state that a recreation must establish before starting the game controller; omitted means the definition does not declare a startup state.",
          "type": "boolean"
        },
        "availability": { "enum": ["used", "unused", "optional", "unknown"] },
        "physical": { "$ref": "#/$defs/physical" },
        "spatial": { "$ref": "#/$defs/spatial" },
        "wiring": { "$ref": "#/$defs/wiring" },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "constant_active": {
          "description": "Whether a constant or virtual input remains permanently active while the controller runs; omitted means the definition does not declare constant activity.",
          "type": "boolean"
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "binding", "aliases", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["coil", "flasher", "lamp", "rgb_lamp", "gi", "motor", "servo", "magnet", "relay", "control_signal", "virtual"]
        },
        "binding": { "$ref": "#/$defs/binding" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/alias" }
        },
        "model": { "$ref": "#/$defs/identifier" },
        "availability": { "enum": ["used", "unused", "optional", "unknown"] },
        "physical": { "$ref": "#/$defs/physical" },
        "spatial": { "$ref": "#/$defs/spatial" },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "wiring": { "$ref": "#/$defs/wiring" },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "type": "number" },
            "maximum": { "type": "number" },
            "steps": { "type": "integer", "minimum": 1 }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["segment", "dmd", "video"] },
        "controller_index": {
          "description": "Zero-based display-layout index exposed by the controller for this physical display.",
          "type": "integer",
          "minimum": 0
        },
        "segment_start": {
          "description": "Zero-based start position in controller display memory for a segment display, measured in digits.",
          "type": "integer",
          "minimum": 0
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "spatial": { "$ref": "#/$defs/displaySpatial" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "displayOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "provenance"],
      "properties": {
        "target": { "$ref": "#/$defs/identifier" },
        "controller_index": {
          "description": "Replacement zero-based controller display-layout index for the target display.",
          "type": "integer",
          "minimum": 0
        },
        "segment_start": {
          "description": "Replacement zero-based controller display-memory start position for the target segment display, measured in digits.",
          "type": "integer",
          "minimum": 0
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "anyOf": [
        { "required": ["controller_index"] },
        { "required": ["segment_start"] },
        { "required": ["width"] },
        { "required": ["height"] }
      ]
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "actuators", "sensors", "behavior", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["drop_target_bank", "diverter", "gate", "kicker", "motorized", "reel", "rotary", "toy", "other"] },
        "actuators": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "sensors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "behavior": { "type": "string", "minLength": 1 },
        "assembly_part_number": { "type": "string", "minLength": 1 },
        "positions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "sensors"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "label": { "type": "string", "minLength": 1 },
              "sensors": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "destination", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["direct", "normally_closed_series", "relay_gated", "inverted", "pulse"] },
        "source": { "$ref": "#/$defs/identifier" },
        "destination": { "$ref": "#/$defs/identifier" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "uri", "locator"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": ["pinmame_catalog", "pinmame_core", "pinmame_sim", "vpe_csharp", "vpe_scene", "legacy_json", "vpx_script", "vpx_table", "manual", "service_bulletin", "service_diagnostic", "rom_static_analysis", "runtime_scenario", "human_review"]
        },
        "uri": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "locator": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "original_filename": { "type": "string", "minLength": 1 },
        "rights": { "type": "string", "minLength": 1 },
        "known_working": { "type": "boolean" },
        "acquired_at": { "type": "string", "format": "date-time" }
      }
    },
    "spatial": {
      "description": "Optional spatial evidence for a device or display in the canonical global playfield space: x=0 is left, x=1 is right, y=0 is the rear/backglass end, and y=1 is the front/apron end. This is normalized VPX/player view and is never inferred from physical.location prose.",
      "oneOf": [
        { "$ref": "#/$defs/spatialLocated" },
        { "$ref": "#/$defs/spatialNotApplicable" }
      ]
    },
    "spatialLocated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "placements"],
      "properties": {
        "status": { "enum": ["candidate", "observed", "validated", "conflicted"] },
        "placements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/spatialPlacement" }
        }
      }
    },
    "spatialNotApplicable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "provenance"],
      "properties": {
        "status": { "const": "not_applicable" },
        "reason": { "enum": ["unused", "virtual", "constant", "dip_switch", "cabinet_or_service", "internal_nonvisual", "no_physical_device"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "displaySpatial": {
      "description": "Displays are cabinet/backbox services, not playfield devices; located playfield display coordinates are unsupported.",
      "$ref": "#/$defs/spatialNotApplicable"
    },
    "spatialPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "space", "x", "y", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "role": { "enum": ["sensor", "effect", "emitter"] },
        "space": { "const": "playfield" },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status"],
      "properties": {
        "path": { "type": "string", "pattern": "^knowledge/.+\\.md$" },
        "status": { "enum": ["stub", "partial", "complete"] }
      }
    },
    "physical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "part_number": { "type": "string", "minLength": 1 },
        "assembly_part_number": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 1 },
        "switch_type": { "enum": ["leaf", "microswitch", "opto", "reed", "button", "dip", "tilt", "other", "unknown"] },
        "shared_emitter_group": { "type": "string", "minLength": 1 },
        "emitter_channel": { "enum": ["blue", "green", "red"] },
        "co_located_addresses": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
        "shared_physical_quantity": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "required": ["shared_emitter_group"] },
              { "required": ["emitter_channel"] },
              { "required": ["co_located_addresses"] },
              { "required": ["shared_physical_quantity"] }
            ]
          },
          "then": {
            "description": "Shared RGB emitter metadata is atomic; quantity is the physical shared quantity.",
            "required": ["quantity", "shared_emitter_group", "emitter_channel", "co_located_addresses", "shared_physical_quantity"]
          }
        }
      ]
    },
    "wiring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "board": { "type": "string", "minLength": 1 },
        "driver_transistor": { "type": "string", "minLength": 1 },
        "drive_wire": { "type": "string", "minLength": 1 },
        "drive_connection": { "type": "string", "minLength": 1 },
        "return_wire": { "type": "string", "minLength": 1 },
        "return_connection": { "type": "string", "minLength": 1 },
        "return_component": { "type": "string", "minLength": 1 },
        "power_wire": { "type": "string", "minLength": 1 },
        "power_connection": { "type": "string", "minLength": 1 },
        "control_wire": { "type": "string", "minLength": 1 },
        "control_connection": { "type": "string", "minLength": 1 },
        "nominal_voltage_v": { "type": "number", "exclusiveMinimum": 0 },
        "voltage_type": { "enum": ["ac", "dc"] }
      }
    },
    "deviceOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "binding"],
      "properties": {
        "target": { "$ref": "#/$defs/identifier" },
        "binding": { "$ref": "#/$defs/binding" }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "description", "source_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "path": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  }
}
