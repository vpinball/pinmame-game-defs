{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vpinball/pinmame-game-defs/schemas/machine.schema.json",
  "title": "PinMAME physical-machine definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "machine",
    "coverage",
    "drivers",
    "inputs",
    "outputs",
    "displays",
    "mechanisms",
    "relationships",
    "sources",
    "knowledge"
  ],
  "properties": {
    "format": { "const": "pinmame-machine-definition" },
    "schema_version": { "const": 1 },
    "machine": { "$ref": "#/$defs/machineIdentity" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "controller": { "$ref": "#/$defs/controller" },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/driver" }
    },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/output" }
    },
    "displays": {
      "type": "array",
      "items": { "$ref": "#/$defs/display" }
    },
    "mechanisms": {
      "type": "array",
      "items": { "$ref": "#/$defs/mechanism" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "knowledge": { "$ref": "#/$defs/knowledge" },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "machineIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "manufacturer", "year"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "manufacturer": { "type": "string", "minLength": 1 },
        "year": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
        "kind": { "enum": ["physical_pinball", "physical_conversion", "virtual_pinball", "redemption_game", "diagnostic_software", "system_software", "unknown"] },
        "model_number": { "type": "string", "minLength": 1 },
        "ipdb_id": { "type": "integer", "minimum": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "missing", "dimensions"],
      "properties": {
        "status": { "enum": ["stub", "partial", "author_ready"] },
        "missing": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "identity",
              "driver_mapping",
              "controller_platform",
              "input_enumeration",
              "input_semantics",
              "output_enumeration",
              "output_semantics",
              "display_inventory",
              "mechanism_inventory",
              "mechanism_behavior",
              "polarity",
              "variant_differences",
              "recreation_notes",
              "provenance",
              "unresolved_conflicts"
            ]
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/assertionState" },
          "required": [
            "catalog_identity",
            "address_enumeration",
            "semantic_naming",
            "physical_wiring",
            "mechanisms",
            "variant_coverage",
            "recreation_knowledge"
          ]
        }
      }
    },
    "assertionState": {
      "enum": ["unknown", "candidate", "observed", "validated", "conflicted", "not_applicable"]
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform"],
      "properties": {
        "platform": { "$ref": "#/$defs/identifier" },
        "hardware_generation": { "type": "string", "pattern": "^0x[0-9a-f]+$" },
        "inversion_applied_by_emulator": { "type": "boolean" }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "year", "manufacturer", "flags"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "clone_of": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1 },
        "year": { "type": "string", "minLength": 1 },
        "manufacturer": { "type": "string", "minLength": 1 },
        "flags": { "type": "integer", "minimum": 0 },
        "physical_compatibility": { "description": "Compatibility of this ROM driver with the physical machine described by the containing definition.", "enum": ["identical", "compatible", "different", "unknown"] },
        "variant_notes": { "type": "string", "minLength": 1 },
        "overrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/deviceOverride" }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "device"],
      "properties": {
        "group": { "$ref": "#/$defs/identifier" },
        "device": { "type": "integer" },
        "channel": { "type": "integer", "minimum": 0 }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "value"],
      "properties": {
        "namespace": { "$ref": "#/$defs/identifier" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_refs"],
      "properties": {
        "status": { "$ref": "#/$defs/assertionState" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "binding", "aliases", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["switch", "dip_switch", "constant", "virtual"] },
        "binding": { "$ref": "#/$defs/binding" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/alias" }
        },
        "normally_closed": { "type": "boolean" },
        "pulse": { "type": "boolean" },
        "initial_active": {
          "description": "Controller-facing active state that a recreation must establish before starting the game controller; omitted means the definition does not declare a startup state.",
          "type": "boolean"
        },
        "availability": { "enum": ["used", "unused", "optional", "unknown"] },
        "physical": { "$ref": "#/$defs/physical" },
        "wiring": { "$ref": "#/$defs/wiring" },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "constant_active": {
          "description": "Whether a constant or virtual input remains permanently active while the controller runs; omitted means the definition does not declare constant activity.",
          "type": "boolean"
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "binding", "aliases", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["coil", "flasher", "lamp", "rgb_lamp", "gi", "motor", "servo", "magnet", "relay", "virtual"]
        },
        "binding": { "$ref": "#/$defs/binding" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/alias" }
        },
        "model": { "$ref": "#/$defs/identifier" },
        "availability": { "enum": ["used", "unused", "optional", "unknown"] },
        "physical": { "$ref": "#/$defs/physical" },
        "wiring": { "$ref": "#/$defs/wiring" },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "type": "number" },
            "maximum": { "type": "number" },
            "steps": { "type": "integer", "minimum": 1 }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["segment", "dmd", "video"] },
        "controller_index": {
          "description": "Zero-based display-layout index exposed by the controller for this physical display.",
          "type": "integer",
          "minimum": 0
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "actuators", "sensors", "behavior", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["drop_target_bank", "diverter", "gate", "kicker", "motorized", "reel", "rotary", "toy", "other"] },
        "actuators": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "sensors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "behavior": { "type": "string", "minLength": 1 },
        "assembly_part_number": { "type": "string", "minLength": 1 },
        "positions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "sensors"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "label": { "type": "string", "minLength": 1 },
              "sensors": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "destination", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["direct", "normally_closed_series", "relay_gated", "inverted", "pulse"] },
        "source": { "$ref": "#/$defs/identifier" },
        "destination": { "$ref": "#/$defs/identifier" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "uri", "locator"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": ["pinmame_catalog", "pinmame_core", "pinmame_sim", "vpe_csharp", "legacy_json", "vpx_script", "vpx_table", "manual", "service_bulletin", "service_diagnostic", "rom_static_analysis", "runtime_scenario", "human_review"]
        },
        "uri": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "locator": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "original_filename": { "type": "string", "minLength": 1 },
        "rights": { "type": "string", "minLength": 1 },
        "acquired_at": { "type": "string", "format": "date-time" }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status"],
      "properties": {
        "path": { "type": "string", "pattern": "^knowledge/.+\\.md$" },
        "status": { "enum": ["stub", "partial", "complete"] }
      }
    },
    "physical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "part_number": { "type": "string", "minLength": 1 },
        "assembly_part_number": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 1 },
        "switch_type": { "enum": ["leaf", "microswitch", "opto", "reed", "button", "dip", "tilt", "other", "unknown"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "wiring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "board": { "type": "string", "minLength": 1 },
        "driver_transistor": { "type": "string", "minLength": 1 },
        "drive_wire": { "type": "string", "minLength": 1 },
        "drive_connection": { "type": "string", "minLength": 1 },
        "return_wire": { "type": "string", "minLength": 1 },
        "return_connection": { "type": "string", "minLength": 1 },
        "return_component": { "type": "string", "minLength": 1 },
        "power_wire": { "type": "string", "minLength": 1 },
        "power_connection": { "type": "string", "minLength": 1 },
        "control_wire": { "type": "string", "minLength": 1 },
        "control_connection": { "type": "string", "minLength": 1 },
        "nominal_voltage_v": { "type": "number", "exclusiveMinimum": 0 },
        "voltage_type": { "enum": ["ac", "dc"] }
      }
    },
    "deviceOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "binding"],
      "properties": {
        "target": { "$ref": "#/$defs/identifier" },
        "binding": { "$ref": "#/$defs/binding" }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "description", "source_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "path": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  }
}
