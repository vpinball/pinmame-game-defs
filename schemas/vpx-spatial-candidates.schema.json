{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vpinball/pinmame-game-defs/schemas/vpx-spatial-candidates.schema.json",
  "title": "Deterministic VPX spatial candidate extraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "source", "coordinate_space", "bounds", "objects"],
  "properties": {
    "format": { "const": "pinmame-vpx-spatial-candidates" },
    "version": { "const": 2 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vpx_sha256", "vpx_size"],
      "properties": {
        "vpx_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "vpx_size": { "type": "integer", "minimum": 1 },
        "vpxtool_version": { "type": "string", "minLength": 1 }
      }
    },
    "coordinate_space": { "const": "playfield" },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "number" },
        "top": { "type": "number" },
        "right": { "type": "number", "exclusiveMinimum": 0 },
        "bottom": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "x", "y"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "center_method": { "enum": ["fields", "center", "position", "drag_point_centroid"] },
          "source_path": { "type": "string", "pattern": "^gameitems/.+\\.json$" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "enum": ["Primitive", "Wall"] } } },
            "then": { "required": ["center_method", "source_path"] }
          }
        ]
      }
    }
  }
}
