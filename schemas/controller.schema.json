{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vpinball/pinmame-game-defs/schemas/controller.schema.json",
  "title": "PinMAME controller routing profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "authority", "hardware_family", "inversion_applied_by_emulator", "groups", "sources"],
  "properties": {
    "format": { "const": "pinmame-controller-profile" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "authority": { "const": "pinmame" },
    "hardware_family": { "type": "string", "minLength": 1 },
    "inversion_applied_by_emulator": { "description": "Consumers must use the public PinMAME API state as delivered and must not apply another controller-wide inversion. This contract does not claim that every public input is active-high or that every physically normally-closed switch has a nonzero per-game inversion mask; platform and per-game notes preserve mixed-level exceptions.", "const": true },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "revision", "locator"],
        "properties": {
          "uri": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "addressRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" },
        "values": { "type": "array", "uniqueItems": true, "items": { "type": "integer" } }
      },
      "oneOf": [
        { "required": ["minimum", "maximum"] },
        { "required": ["values"] }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "direction", "kind", "label", "address_rules", "transports"],
      "dependentRequired": { "notes_format": ["notes"] },
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "direction": { "enum": ["input", "controlled_device", "configuration"] },
        "kind": { "enum": ["switch", "dip_switch", "solenoid", "lamp", "gi"] },
        "label": { "type": "string", "minLength": 1 },
        "address_rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/addressRule" } },
        "transports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "libpinmame": {
              "type": "object",
              "additionalProperties": false,
              "required": ["channel"],
              "properties": { "channel": { "enum": ["switch", "solenoid", "lamp", "gi", "dip"] } }
            },
            "controller_plugin": {
              "type": "object",
              "additionalProperties": false,
              "required": ["group_id", "contract_revision"],
              "properties": {
                "group_id": { "type": "integer", "minimum": 0 },
                "contract_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
              }
            }
          }
        },
        "notes": { "description": "Technical behavior and exceptions for this controller group. Content is plain text unless notes_format explicitly selects Markdown.", "type": "string", "minLength": 1 },
        "notes_format": { "description": "How notes is rendered by catalog consumers. Omit this field or use plain_text for literal prose. Use markdown only for reviewed GitHub Flavored Markdown, start nested headings at level 4, and do not embed raw HTML; consumers must escape raw HTML, reject unsafe link and image URL schemes, and keep headings at level 4 or deeper.", "enum": ["plain_text", "markdown"], "default": "plain_text" }
      }
    }
  }
}
