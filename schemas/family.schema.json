{
  "$id": "https://github.com/vpinball/pinmame-game-defs/schemas/family.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "family": {
      "additionalProperties": false,
      "properties": {
        "id": { "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "type": "string" },
        "manufacturer": { "minLength": 1, "type": "string" },
        "opdb_id": { "pattern": "^G[A-Za-z0-9]+$", "type": "string" },
        "title": { "minLength": 1, "type": "string" }
      },
      "required": ["id", "title", "opdb_id"],
      "type": "object"
    },
    "format": { "const": "pinmame-machine-family" },
    "members": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "differences": { "minLength": 1, "type": "string" },
          "edition": { "minLength": 1, "type": "string" },
          "machine_id": { "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "type": "string" }
        },
        "required": ["machine_id"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": { "const": 1 },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acquired_at": { "format": "date-time", "type": "string" },
          "attribution": { "minLength": 1, "type": "string" },
          "id": { "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "type": "string" },
          "kind": { "const": "human_review" },
          "license": { "minLength": 1, "type": "string" },
          "locator": { "minLength": 1, "type": "string" },
          "revision": { "minLength": 1, "type": "string" },
          "sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
          "uri": { "minLength": 1, "type": "string" }
        },
        "required": ["id", "kind", "uri", "revision", "sha256", "locator", "license", "attribution", "acquired_at"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": ["format", "schema_version", "family", "members", "sources"],
  "title": "PinMAME physical-machine family",
  "type": "object"
}
