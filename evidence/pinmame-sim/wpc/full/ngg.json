  "recreation_notes": [
    {
      "line_end": 13,
      "line_start": 3,
      "status": "candidate",
      "text": "No Good Gofers (Williams, 1997) Pinball Simulator\nby Dave Roberts (daverob@cwcom.net)\nFeb. 16, 2001\nKnown Issues : - It is possible for a weak loop shot to fall into the Putt\nOut hole, but we are not going to simulate these cases\n- Some functions have more comment than code, but I wrote the\ncomments first and couldn't bring myself to remove them ;-)"
    }
  ],
