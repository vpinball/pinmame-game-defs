{
  "format": "pinmame-harness-scenario",
  "version": 1,
  "game": "frpwr_l6",
  "notes": "Williams System 6 Test 03 (switch test) per the Firepower instruction booklet 16P-497-103 diagnostic procedure steps 1-7: the credit display shows 03 and the ball-in-play display shows the number of each switch the ROM sees closed. Each public switch 1-64 is closed alone for 400 ms with a snapshot taken while held, so the displayed number can be paired with the public address that was driven. Run from an NVRAM initialized by one prior empty-NVRAM power-up, because a first power-up from empty CMOS stops on the game-identification/audit screen.",
  "watch_switches": [
    -7,
    -6
  ],
  "actions": [
    {
      "type": "wait",
      "seconds": 6.0,
      "label": "settle into game-over attract mode"
    },
