{
  "format": "pinmame-harness-scenario",
  "version": 1,
  "notes": "Phantom of the Opera poto_a32 all-direct service walk. Keyboard handling remains off to avoid s11.c SWITCH_UPDATE overwriting matrix1-8. Public -6 is the toggled Green direction level; public -7 is Black Advance; public84/82 are left/right cabinet flipper inputs copied into matrix15/16 by core_updateSw. Every switch probe is preceded by a different reference input and held3s, with wire/address display pairing. Fresh state with5s boot stabilization. COIL TEST is this game's own manual printed26/ROM title. Host switch readback is stimulus, never ROM evidence. Failed COIL AUTO attempts and key-mixed v2runs are retained diagnostic artifacts only.",
  "watch_switches": [
    -7,
    -6,
    15,
    16,
    82,
    84
  ],
  "actions": [
    {
      "type": "set_switch",
      "switch": -6,
      "state": 1,
      "label": "set toggled Green service input to 1"
    },
    {
