      "seconds": 0.75,
      "label": "allow service direction switch to settle"
    },
    {
      "type": "pulse_until_display",
      "texts": [
        "SWITCH TEST"
      ],
      "max_pulses": 40,
      "hold_ms": 250,
      "settle_s": 0.9,
      "label": "advance through sound and display diagnostics to Switch Test",
      "switch": -7
    },
    {
      "type": "wait",
      "seconds": 2.0,
      "label": "let the Switch Test title settle"
    },
    {
      "type": "pulse",
      "switch": 3,
