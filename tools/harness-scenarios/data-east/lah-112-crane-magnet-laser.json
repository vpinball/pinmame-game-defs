{
  "format": "pinmame-harness-scenario",
  "version": 1,
  "game": "lah_112",
  "notes": "Version 1.12 Crane Test, Magnet Test and Laser Kick Test: what the crane screen reports for each limit switch, which output Start and the trigger drive, which outputs the magnet test cycles, and which playfield switches fire which coil.",
  "watch_switches": [
    -7,
    -6,
    3,
    8,
    16,
    22,
