{
  "format": "pinmame-harness-scenario",
  "version": 1,
  "notes": "Diner Single Lamps test (lower display 04): the ROM blinks one lamp and names it on the upper display, and the Start button (public 3) steps the designator 01-64. Pairs each name and designator with the public lamp address that blinks.",
  "watch_switches": [
    -7,
    -6,
    3
  ],
  "actions": [
    {
      "type": "wait",
      "seconds": 8,
      "label": "stabilize initialized ROM"
    },
    {
      "type": "set_switch",
      "switch": -6,
      "state": 0,
      "settle_s": 0.3,
      "label": "manual down"
    },
