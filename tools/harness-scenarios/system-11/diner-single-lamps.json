      "type": "pulse",
      "switch": -7,
      "hold_ms": 200,
      "settle_s": 2,
      "label": "enter diagnostic tests (MUSIC TEST)"
    },
    {
      "type": "set_switch",
      "switch": -6,
      "state": 1,
      "settle_s": 0.3,
      "label": "auto up"
    },
    {
