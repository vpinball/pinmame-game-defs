{
  "format": "pinmame-harness-scenario",
  "version": 1,
  "notes": "Pin-Bot gameplay probe from the retained initialized NVRAM in which the host answers the ROM's visor and ramp drives the way the hardware would: Visor Open (47) closes after power-up; when the ROM energizes the visor motor relay (13) again the host moves the visor from Visor Open to Visor Closed (46); once a game is started the host waits for a Ramp Lower pulse (6) before closing Ramp Down (44). Trough #1 and #2 (17, 18) are held from start. One ball is then served, plunged, played through the Vortex, the visor and 5-bank targets, Advance Planet, Score Energy, the ramp and the single eject, and drained through the left outlane and outhole. Auto-Up (-6 = 1) held from start. Timings are host choices; a pulse the ROM fires proves only that the address changed under these conditions.",
  "initial_switches": [
    {
      "switch": -6,
      "state": 1
    },
    {
      "switch": 17,
      "state": 1
    },
    {
      "switch": 18,
      "state": 1
    }
  ],
  "watch_switches": [
    -6,
    16,
    17,
    18,
    20,
    38,
    44,
    46,
    47
  ],
