{
  "format": "pinmame-harness-scenario",
  "version": 1,
  "notes": "Pin-Bot Switch Levels test (Credit display 05): while a switch is closed the BALL IN PLAY/MATCH display shows its number and the player 1 and 2 displays its name. Each public matrix address 1-64 and PinMAME's flipper column 81-88 is held at 1 alone for 1.5 s with a snapshot while held. Switches 10 and 11 are FLIP_SWNO targets that core_updateSw rewrites from the flipper column every update, so their direct holds are expected to be overwritten and the column holds are what reach them.",
  "watch_switches": [
    -7,
    -6
  ],
  "actions": [
    {
      "type": "wait",
      "seconds": 8,
      "label": "stabilize initialized ROM"
    },
    {
      "type": "set_switch",
      "switch": -6,
      "state": 0,
      "settle_s": 0.3,
      "label": "manual down"
    },
    {
      "type": "pulse",
      "switch": -7,
      "hold_ms": 200,
      "settle_s": 2,
      "label": "enter diagnostic tests (MUSIC TEST)"
    },
    {
      "type": "set_switch",
      "switch": -6,
      "state": 1,
      "settle_s": 0.3,
      "label": "auto up"
    },
    {
      "type": "pulse_until_display",
      "switch": -7,
      "texts": [
        "LEVELS"
      ],
      "max_pulses": 12,
      "hold_ms": 200,
      "settle_s": 2.5,
      "label": "locate SWITCH LEVELS"
    },
    {
      "type": "wait",
      "seconds": 2,
      "label": "no switch closed"
    },
    {
      "type": "pulse",
      "switch": 1,
      "hold_ms": 1500,
      "settle_s": 1.0,
      "snapshot_while_held": true,
