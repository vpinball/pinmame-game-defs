{
  "format": "pinmame-harness-scenario",
  "version": 1,
  "game": "bcats_l5",
  "notes": "System 11B Switch Levels: isolate switch 44 and use switch 39 as a named control. A ROM label does not establish physical fitment or contact construction.",
  "initial_switches": [{"switch": -6, "state": 1}],
  "watch_switches": [-7, -6, 39, 44],
  "actions": [
    {"type": "wait", "seconds": 16, "label": "stabilize initialized ROM"},
    {"type": "set_switch", "switch": -6, "state": 0, "settle_s": 0.3, "label": "Manual Down"},
    {"type": "pulse", "switch": -7, "hold_ms": 200, "settle_s": 2, "label": "enter diagnostics"},
    {"type": "set_switch", "switch": -6, "state": 1, "settle_s": 0.3, "label": "Auto Up"},
    {"type": "pulse_until_display", "switch": -7, "texts": ["SWITCH LEVELS"], "max_pulses": 15, "hold_ms": 200, "settle_s": 2, "label": "locate Switch Levels"},
    {"type": "set_switch", "switch": 39, "state": 1, "settle_s": 3, "label": "control switch 39 closed"},
    {"type": "set_switch", "switch": 39, "state": 0, "settle_s": 2, "label": "control switch 39 released"},
    {"type": "set_switch", "switch": 44, "state": 1, "settle_s": 3, "label": "switch 44 closed"},
    {"type": "set_switch", "switch": 44, "state": 0, "settle_s": 2, "label": "switch 44 released"}
  ]
}
