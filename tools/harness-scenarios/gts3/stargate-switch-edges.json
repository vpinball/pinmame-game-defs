{
  "format": "pinmame-harness-scenario",
  "version": 1,
  "notes": "Self-test 6 Switch Edges Test; every gts3 matrix address 0-117 except the credit button (4), then -5 and -7, is held at public 1 for 400 ms, one at a time; 81 and 82 are closed through the flipper buttons 143 and 141 that core_updateSw copies into them. Navigation: two Test (-8) presses reach the menu with SELF-TEST highlighted, the right flipper button (141, which core_updateSw copies into matrix switch 82) selects it, a 12 s wait lets SELF-TEST 1 MEMORY TEST finish (Test presses are ignored while it runs), and each further Test press steps to the next self-test.",
  "switch_converter": "gts3",
  "actions": [
    {
      "type": "wait",
      "seconds": 8,
      "label": "boot to attract"
    },
    {
      "type": "pulse",
      "switch": -8,
      "hold_ms": 200,
      "settle_s": 1.5,
      "label": "test button: TEST MODE"
    },
    {
      "type": "pulse",
      "switch": -8,
      "hold_ms": 200,
      "settle_s": 1.5,
      "label": "test button: menu (SELF-TEST highlighted)"
    },
    {
      "type": "pulse",
      "switch": 141,
      "hold_ms": 200,
      "settle_s": 3,
      "label": "right flipper: select SELF-TEST"
    },
    {
      "type": "wait",
      "seconds": 12,
      "label": "let SELF-TEST 1 MEMORY TEST finish"
    },
    {
