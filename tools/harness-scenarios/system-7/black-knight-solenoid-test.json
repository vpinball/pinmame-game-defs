{
  "format": "pinmame-harness-scenario",
  "version": 1,
  "game": "bk_l4",
  "notes": "Williams System 7 diagnostics per the Black Knight instruction booklet: Manual-Down (public -6 = 0) plus Advance (public -7) enters the display digits test; Auto-Up then Advance steps Test 00 (sound), Test 01 (lamps) and Test 02 (solenoids), each shown in the credit display. Manual-Down in Test 02 holds one step, which the ROM pulses repeatedly while the ball-in-play display shows its number; each further Advance moves to the next step, 01 to 25 and round again. Only direct switch writes are used, so PinMAME's keyboard handling and the driver's built-in simulator stay off. Run from an NVRAM initialized by one prior empty-NVRAM power-up.",
  "watch_switches": [
    -7,
    -6
  ],
