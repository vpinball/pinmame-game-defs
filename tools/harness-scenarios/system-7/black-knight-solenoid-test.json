      "switch": -6,
      "state": 0,
      "settle_s": 0.5,
      "label": "Auto/Manual toggle to Manual-Down"
    },
    {
      "type": "pulse",
      "switch": -7,
      "hold_ms": 200,
      "settle_s": 2.0,
      "label": "Advance: display digits test, all 0s"
    },
    {
      "type": "set_switch",
      "switch": -6,
      "state": 1,
      "settle_s": 3.0,
      "label": "Auto-Up: digits cycle"
    },
    {
