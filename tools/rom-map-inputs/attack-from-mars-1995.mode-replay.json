  "notes": [
    "A recipe is an ordered step list. Feed each `sw` to Controller.Switch(n) for `hold` ms, wait `gap` ms, next step.",
    "Steps written as an `op` are mechanical rather than a plain closure: a ball arriving in the saucer, the left popper or the right scoop, where the script must also clear the opto when the kick solenoid fires.",
    "A recipe carries a PRECONDITION. Run one with requires.mode_word 0 while a multiball is up and the identical closures score jackpots instead of starting the mode.",
    "No RAM write reaches the machine on stock VPinMAME, so switch closures are the only way in short of patching the ROM."
  ],
  "ops": {
    "ball": "ensure one ball is in play; serve and plunge if not",
    "clear": "drain until the running-mode word at 0x0294/0x0295 reads 0, so the recipe starts from ordinary play",
    "lockpopper": "ball arrives at the left popper: Switch(36)=0, then =1 when solenoid 3 fires",
    "saucer": "ball enters the mothership saucer (sw78 closed 120 ms), ROM kicks it to the left popper",
    "scoop": "ball arrives at the right scoop: Switch(37)=0, then =1 when solenoid 4 fires",
    "wait": "do nothing for gap ms"
  },
  "timing": {
    "comfortable_closed_ms": 60,
    "min_closed_ms": 4,
    "same_switch_gap_ms": 120,
    "why": "measured on the jets in 20-hit batches: 2 ms closed registers 0/20, 4 ms registers 19/20; 100 ms between closures of the same switch registers 19/20, 120 ms registers 20/20"
  }
}
