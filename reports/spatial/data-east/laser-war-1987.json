      ],
      "dimension": "polarity",
      "reason": "The community technical chart prints the physical flipper/EOS wiring, but controller-facing runtime behavior conflicts with the printed EOS labels and no retained evidence establishes the polarity translation.",
      "would_resolve": "Bench observation of controller-facing flipper-button and EOS polarity synchronized with the physical contacts."
    },
    {
      "devices": [
        "coil.driver-17",
        "coil.driver-18",
